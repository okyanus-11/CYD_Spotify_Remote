[TEMPLATE]
# Copy to .env and fill in locally. Never commit .env or .spotify_cache.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_CACHE_PATH=.spotify_cache

# Required: generate a unique random value of at least 32 characters and enter
# the same value in firmware/CYD_Spotify_Remote/config.h as CYD_API_TOKEN.
CYD_API_TOKEN=

# 0.0.0.0 makes the server reachable by the CYD on the same trusted LAN.
CYD_SERVER_HOST=0.0.0.0
CYD_SERVER_PORT=5000
